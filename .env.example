# AlphaQuant Engine - Variáveis de Ambiente
# ==========================================
#
# FASE 1 (atual): nenhuma variável é obrigatória.
# Todos os endpoints usados hoje são públicos (Binance Market Data),
# não é necessária nenhuma API Key.
#
# As variáveis abaixo são placeholders para as integrações futuras
# previstas no projeto (CoinGlass, Fear & Greed Index, etc.).
# Copie este arquivo para ".env" e preencha apenas quando essas
# integrações forem implementadas.

# ---- Binance (Fase 1 - não requer chave) ---------------------------
BINANCE_BASE_URL=https://api.binance.com

# ---- CoinGlass (uso futuro) -----------------------------------------
# COINGLASS_API_KEY=

# ---- Fear & Greed Index (uso futuro) --------------------------------
# FEAR_AND_GREED_API_URL=https://api.alternative.me/fng/

# ---- Configurações gerais da aplicação -------------------------------
DEBUG_MODE=true
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=4H
